# Porta do servidor
PORT=3000
# URL pública do site (usada nos links de pagamento e no webhook do WhatsApp)
PUBLIC_URL=https://seu-dominio.com.br

# Segredo para assinar sessões e criptografar tokens dos clientes (gere com: openssl rand -hex 32)
APP_SECRET=troque-isto-por-um-valor-aleatorio-longo

# Chave da API da Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Mercado Pago (deixe vazio para modo de teste: o plano é ativado sem cobrança)
MERCADOPAGO_ACCESS_TOKEN=

# Segundos que o bot espera depois da última mensagem do cliente antes de responder
# (as pessoas costumam mandar várias mensagens seguidas)
BUFFER_SECONDS=6
